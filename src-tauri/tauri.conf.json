{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bonsai",
  "version": "0.1.0",
  "identifier": "app.bonsai.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/ollama"]
  }
}
